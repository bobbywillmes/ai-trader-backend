generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider            = "prisma-dbml-generator"
  output              = "../docs/database"
  outputName          = "ai-trader.dbml"
  projectName         = "AI Trader Backend"
  projectDatabaseType = "PostgreSQL"
  projectNote         = "Generated from prisma/schema.prisma. Do not edit manually."
}

datasource db {
  provider = "postgresql"
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlatformRole {
  SYSTEM_OWNER
  OPERATOR
  ACCOUNT_USER
}

model User {
  id                          Int     @id @default(autoincrement())

  email                       String  @unique
  passwordHash                String?
  platformRole                PlatformRole @default(ACCOUNT_USER)
  enabled                     Boolean @default(true)

  name                        String?
  emailVerifiedAt             DateTime?
  invitedAt                   DateTime?
  invitedByUserId             Int?
  invitedByUser               User?      @relation("UserInvites", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedUsers                User[]     @relation("UserInvites")
  setupCompletedAt            DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sessions                    UserSession[]
  setupTokens                 UserSetupToken[]

  heldTradingAccounts         TradingAccount[]           @relation("TradingAccountHolder")
  tradingAccountMemberships   TradingAccountMembership[]
  systemEventsActed           SystemEvent[]               @relation("SystemEventActor")
  operationalAttentionsAcknowledged OperationalAttention[] @relation("OperationalAttentionAcknowledgedBy")
  operationalAttentionsResolved     OperationalAttention[] @relation("OperationalAttentionResolvedBy")
  readinessAssessmentsRequested TradingAccountReadinessAssessment[] @relation("ReadinessAssessmentRequester")
  lifecycleExercisesCreated   TradingLifecycleExercise[]  @relation("LifecycleExerciseCreator")
  lifecycleExerciseTargets    TradingLifecycleExerciseTarget[] @relation("LifecycleExerciseAccountHolder")
  liveWriteApprovalsGranted   TradingAccountLiveWriteApproval[] @relation("LiveWriteApprovalGranter")
  liveWriteApprovalsRevoked   TradingAccountLiveWriteApproval[] @relation("LiveWriteApprovalRevoker")
  liveWriteApprovalDecisions  TradingAccountLiveWriteApprovalDecision[] @relation("LiveWriteApprovalDecisionActor")
  liveEntryArmings            LiveEntryArming[] @relation("LiveEntryArmingActor")
  liveEntryArmingTerminations LiveEntryArmingTermination[] @relation("LiveEntryArmingTerminationActor")
  liveEntryAcceptanceRunsCreated LiveEntryAcceptanceRun[] @relation("LiveEntryAcceptanceRunCreator")
  liveEntryAcceptanceExecutions LiveEntryAcceptanceRun[] @relation("LiveEntryAcceptanceRunExecutor")
  liveEntryAcceptanceTerminations LiveEntryAcceptanceRun[] @relation("LiveEntryAcceptanceRunTerminator")
  lifecycleRepairCasesCreated LifecycleRepairCase[]       @relation("LifecycleRepairCaseCreator")
  lifecycleRepairExecutions   LifecycleRepairExecution[]  @relation("LifecycleRepairExecutionActor")
  lifecycleRepairActionDecisions LifecycleRepairAction[]  @relation("LifecycleRepairActionDecisionActor")
}

model UserSetupToken {
  id                          Int    @id @default(autoincrement())
  userId                      Int
  tokenHash                   String @unique

  expiresAt                   DateTime
  usedAt                      DateTime?
  revokedAt                   DateTime?

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user                        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([revokedAt])
}

model UserSession {
  id        Int    @id @default(autoincrement())
  userId    Int
  tokenHash String @unique

  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum TradingBroker {
  ALPACA
}

enum TradingAccountEnvironment {
  PAPER
  LIVE
}

enum TradingAccountStatus {
  NEEDS_CREDENTIALS
  ACTIVE
  PAUSED
  DISABLED
  ERROR
}

enum PositionSizingType {
  FIXED_QTY
  MAX_NOTIONAL
}

enum TradingAccountReadinessPurpose {
  LIVE_ACTIVATION
  LIVE_ENTRY_ARMING
}

enum LiveEntryArmingTerminationType {
  DISARMED
  INVALIDATED
  EXPIRED
  CONSUMED
}

enum LiveEntryAcceptanceTerminalOutcome {
  CANARY_COMPLETE
  FAILED_SAFE
  OPERATOR_ABORTED
}

enum TradingAccountReadinessResult {
  PASSED
  BLOCKED
  ERROR
}

enum LiveWriteCapability {
  RISK_REDUCING
  ENTRY
}

enum LiveWriteApprovalStatus {
  GRANTED
  REVOKED
  INVALIDATED
}

enum LiveWriteApprovalAction {
  GRANT
  REVOKE
  INVALIDATE
}

model TradingAccount {
  id                        Int @id @default(autoincrement())

  // Identifies the person whose brokerage account this record represents.
  // This relationship does not grant authorization by itself.
  accountHolderUserId Int
  accountHolder             User @relation("TradingAccountHolder", fields: [accountHolderUserId], references: [id])

  displayName               String

  broker                    TradingBroker @default(ALPACA)
  environment               TradingAccountEnvironment @default(PAPER)
  status                    TradingAccountStatus @default(NEEDS_CREDENTIALS)

  tradingEnabled            Boolean @default(false)
  killSwitchEnabled         Boolean @default(true)

  estimatedTradingCapital   Float?

  // Authoritative ceiling for the total capital controlled by enabled allocations.
  // Nullable while legacy account risk configuration is identified and corrected.
  maxDeployableNotional     Float?
  baseCurrency              String @default("USD")

  brokerAccountId           String?
  brokerAccountNumberMasked String?
  brokerAccountStatus       String?

  lastBrokerSyncAt          DateTime?
  lastCash                  Float?
  lastBuyingPower           Float?
  lastEquity                Float?
  lastPortfolioValue        Float?
  tradingBlocked            Boolean?

  pausedReason              String?
  notes                     String?

  credential                TradingAccountCredential?
  riskSettings              TradingAccountRiskSettings?
  memberships               TradingAccountMembership[]

  // Future/current trading relations
  allocations               TradingAccountAllocation[]
  accountSubscriptions      TradingAccountSubscription[]
  orderIntents              OrderIntent[]
  brokerOrders              BrokerOrder[]
  brokerActivities          BrokerActivity[]
  trackedPositions          TrackedPosition[]
  accountSnapshots          AccountSnapshot[]
  entryDecisions            EntryDecision[]
  systemEvents              SystemEvent[]
  operationalAttentions    OperationalAttention[]
  alpacaApiUsageBuckets     AlpacaApiUsageBucket[]
  workerHealthStates        TradingAccountWorkerHealthState[]
  readinessAssessments      TradingAccountReadinessAssessment[]
  liveWriteApprovals        TradingAccountLiveWriteApproval[]
  liveWriteApprovalDecisions TradingAccountLiveWriteApprovalDecision[]
  liveEntryArmings           LiveEntryArming[] @relation("LiveEntryArmingAccount")
  liveEntryAcceptanceRuns    LiveEntryAcceptanceRun[]
  activeLiveEntryArmingId    Int? @unique
  activeLiveEntryArming      LiveEntryArming? @relation("ActiveLiveEntryArming", fields: [activeLiveEntryArmingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lifecycleExerciseTargets  TradingLifecycleExerciseTarget[]
  lifecycleRepairCases      LifecycleRepairCase[]

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([accountHolderUserId])
  @@index([broker, environment])
  @@index([status])
  @@index([tradingEnabled])
  @@index([killSwitchEnabled])
  @@unique([accountHolderUserId, broker, environment], map: "TradingAccount_holder_broker_environment_key")
  @@unique([broker, environment, brokerAccountId])
}

enum LifecycleRepairType {
  RESOLVE_POSITION_ATTRIBUTION
  REPAIR_HISTORICAL_ENTRY_LIFECYCLE
}

enum LifecycleRepairImpact {
  LOCAL_ONLY
}

enum LifecycleRepairSource {
  MANUAL_DIAGNOSIS
  RECONCILIATION
  WORKER_FAILURE
}

enum LifecycleRepairConfidence {
  DETERMINISTIC
  STRONG
  AMBIGUOUS
  INSUFFICIENT
}

enum LifecycleRepairExecutionResult {
  SUCCEEDED
  FAILED
}

enum LifecycleRepairActionType {
  TERMINALIZE_ORDER_LIFECYCLE
  LINK_ENTRY_LIFECYCLE_TO_POSITION
}

enum LifecycleRepairActionClassification {
  DETERMINISTIC
  OPERATOR_CONFIRMATION_REQUIRED
}

enum LifecycleRepairActionStatus {
  PROPOSED
  APPROVED
  REFUSED
  APPLIED
  VERIFIED
  FAILED
  SUPERSEDED
}

model LifecycleRepairCase {
  id                         Int @id @default(autoincrement())
  repairType                 LifecycleRepairType
  repairVersion              Int
  impact                     LifecycleRepairImpact
  source                     LifecycleRepairSource
  tradingAccountId           Int
  tradingAccount             TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  targetType                 String
  targetId                   String
  confidence                 LifecycleRepairConfidence
  resolutionSource           String?
  diagnosticFingerprint      String
  localLifecycleFingerprint  String
  configurationFingerprint   String?
  evidenceJson               Json
  candidateResolutionsJson   Json
  rejectedAlternativesJson   Json
  beforeJson                 Json
  proposedMutationsJson      Json
  preconditionsJson          Json
  brokerImpactJson           Json
  executableAtCreation       Boolean @default(false)
  nonExecutableReasonsJson   Json
  createdByUserId            Int
  createdByUser              User @relation("LifecycleRepairCaseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                  DateTime @default(now())
  expiresAt                  DateTime
  executions                 LifecycleRepairExecution[]
  actions                    LifecycleRepairAction[]

  @@unique([repairType, targetType, targetId, diagnosticFingerprint], map: "LifecycleRepairCase_type_target_fingerprint_key")
  @@index([tradingAccountId, createdAt])
  @@index([repairType, targetType, targetId, createdAt], map: "LifecycleRepairCase_type_target_createdAt_idx")
  @@index([confidence, createdAt])
  @@index([expiresAt])
  @@index([createdByUserId, createdAt])
}

model LifecycleRepairAction {
  id                         Int @id @default(autoincrement())
  caseId                     Int
  repairCase                 LifecycleRepairCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actionType                 LifecycleRepairActionType
  ordinal                    Int
  classification             LifecycleRepairActionClassification
  status                     LifecycleRepairActionStatus @default(PROPOSED)
  revision                   Int @default(1)
  actionFingerprint          String
  proposedMutationsJson      Json
  preconditionsJson          Json
  evidenceJson               Json
  decidedByUserId            Int?
  decidedByUser              User? @relation("LifecycleRepairActionDecisionActor", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByUserIdSnapshot    Int?
  decidedAt                  DateTime?
  decisionReason             String?
  supersedesActionId         Int?
  supersedesAction           LifecycleRepairAction? @relation("LifecycleRepairActionSupersession", fields: [supersedesActionId], references: [id], onDelete: Restrict)
  supersededBy               LifecycleRepairAction[] @relation("LifecycleRepairActionSupersession")
  beforeJson                 Json
  afterJson                  Json?
  verificationJson           Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  executions                 LifecycleRepairExecution[]

  @@unique([caseId, ordinal])
  @@unique([actionType, actionFingerprint])
  @@index([caseId, status])
  @@index([decidedByUserId, decidedAt])
  @@index([supersedesActionId])
}

model LifecycleRepairExecution {
  id                    Int @id @default(autoincrement())
  caseId                Int
  repairCase            LifecycleRepairCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actionId              Int?
  action                LifecycleRepairAction? @relation(fields: [actionId], references: [id], onDelete: Restrict)
  attemptKey            String @unique
  result                LifecycleRepairExecutionResult
  executedByUserId      Int
  executedByUser        User @relation("LifecycleRepairExecutionActor", fields: [executedByUserId], references: [id], onDelete: Restrict)
  reason                String
  confirmation          String
  diagnosticFingerprint String
  beforeJson            Json
  afterJson             Json?
  validationJson        Json?
  failureJson           Json?
  executedAt            DateTime @default(now())

  @@index([caseId, executedAt])
  @@index([actionId, executedAt])
  @@index([executedByUserId, executedAt])
}

model TradingAccountReadinessAssessment {
  id                              Int @id @default(autoincrement())
  tradingAccountId                Int
  tradingAccount                  TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  purpose                         TradingAccountReadinessPurpose
  result                          TradingAccountReadinessResult
  assessmentVersion               Int
  startedAt                       DateTime
  completedAt                     DateTime
  expiresAt                       DateTime
  configurationFingerprint        String
  credentialFingerprint           String
  policyFingerprint               String
  credentialVerifiedAt            DateTime?
  accountSnapshotId               Int?
  accountSnapshot                 AccountSnapshot? @relation(fields: [accountSnapshotId], references: [id], onDelete: SetNull)
  brokerAccountId                 String?
  brokerAccountStatus             String?
  tradingBlocked                  Boolean?
  brokerPositionCount             Int?
  brokerOpenOrderCount            Int?
  localOpenPositionCount          Int
  localClosingPositionCount       Int
  localNonterminalIntentCount     Int
  localNonterminalOrderCount      Int
  reconciliationSummaryJson       Json?
  stageResultsJson                Json
  gateResultsJson                 Json
  blockersJson                    Json
  warningsJson                    Json
  evidenceJson                    Json
  requestedByUserId               Int?
  requestedByUser                 User? @relation("ReadinessAssessmentRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  liveWriteApprovals              TradingAccountLiveWriteApproval[]
  liveWriteApprovalDecisions      TradingAccountLiveWriteApprovalDecision[]
  liveEntryArmings                LiveEntryArming[]
  createdAt                       DateTime @default(now())

  @@index([tradingAccountId, createdAt])
  @@index([tradingAccountId, completedAt])
  @@index([tradingAccountId, purpose, completedAt])
  @@index([result])
  @@index([expiresAt])
}

model TradingAccountLiveWriteApproval {
  id                       Int @id @default(autoincrement())
  tradingAccountId         Int
  tradingAccount           TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  capability               LiveWriteCapability
  status                   LiveWriteApprovalStatus
  revision                 Int @default(0)
  configurationFingerprint String
  credentialFingerprint    String
  readinessAssessmentId    Int?
  readinessAssessment      TradingAccountReadinessAssessment? @relation(fields: [readinessAssessmentId], references: [id], onDelete: SetNull)
  grantedByUserId          Int?
  grantedByUser            User? @relation("LiveWriteApprovalGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedAt                DateTime?
  grantReason              String?
  revokedByUserId          Int?
  revokedByUser            User? @relation("LiveWriteApprovalRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedAt                DateTime?
  invalidationReason       String?
  expiresAt                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  entryArmings             LiveEntryArming[] @relation("EntryArmingApproval")
  riskReducingArmings      LiveEntryArming[] @relation("RiskReducingArmingApproval")

  @@unique([tradingAccountId, capability])
  @@index([status])
  @@index([expiresAt])
}

model LiveEntryArming {
  id                              Int @id @default(autoincrement())
  tradingAccountId                Int
  tradingAccount                  TradingAccount @relation("LiveEntryArmingAccount", fields: [tradingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeForAccount                TradingAccount? @relation("ActiveLiveEntryArming")
  entryApprovalId                 Int
  entryApproval                   TradingAccountLiveWriteApproval @relation("EntryArmingApproval", fields: [entryApprovalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entryApprovalRevision           Int
  riskReducingApprovalId          Int
  riskReducingApproval            TradingAccountLiveWriteApproval @relation("RiskReducingArmingApproval", fields: [riskReducingApprovalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  riskReducingApprovalRevision    Int
  readinessAssessmentId           Int
  readinessAssessment             TradingAccountReadinessAssessment @relation(fields: [readinessAssessmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  readinessVersion                Int
  tradingAccountSubscriptionId    Int
  tradingAccountSubscription      TradingAccountSubscription @relation(fields: [tradingAccountSubscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionId                  Int
  subscription                    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  securityId                      Int
  security                        Security @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configurationFingerprint        String
  credentialFingerprint           String
  policyFingerprint               String
  entryApprovalExpiresAt          DateTime
  accountUpdatedAtEvidence        DateTime
  armedByUserId                   Int
  armedByUser                     User @relation("LiveEntryArmingActor", fields: [armedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reason                          String
  typedConfirmation               String
  armedAt                         DateTime @default(now())
  terminations                    LiveEntryArmingTermination[]
  liveEntryAcceptanceRunId        Int? @unique
  liveEntryAcceptanceRun          LiveEntryAcceptanceRun? @relation(fields: [liveEntryAcceptanceRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tradingAccountId, armedAt])
  @@index([entryApprovalId, entryApprovalRevision])
  @@index([tradingAccountSubscriptionId, armedAt])
  @@index([entryApprovalExpiresAt])
}

model LiveEntryAcceptanceRun {
  id                              Int @id @default(autoincrement())
  tradingAccountId                Int
  tradingAccount                  TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tradingAccountSubscriptionId    Int
  tradingAccountSubscription      TradingAccountSubscription @relation(fields: [tradingAccountSubscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionId                  Int
  subscription                    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  securityId                      Int
  security                        Security @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId                 Int
  createdByUser                   User @relation("LiveEntryAcceptanceRunCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reason                          String
  previewRevision                 Int @default(0)
  previewFingerprint              String?
  previewJson                     Json?
  previewedAt                     DateTime?
  executionClaimedAt              DateTime?
  executionRequestedByUserId      Int?
  executionRequestedByUser        User? @relation("LiveEntryAcceptanceRunExecutor", fields: [executionRequestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  executionRequestKey             String? @unique
  executionUncertainAt            DateTime?
  executionFailureJson            Json?
  terminalOutcome                 LiveEntryAcceptanceTerminalOutcome?
  terminalReason                  String?
  terminalEvidenceJson            Json?
  terminalAt                      DateTime?
  terminatedByUserId              Int?
  terminatedByUser                User? @relation("LiveEntryAcceptanceRunTerminator", fields: [terminatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  liveEntryArming                 LiveEntryArming?
  orderIntent                     OrderIntent?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@index([tradingAccountId, createdAt])
  @@index([tradingAccountSubscriptionId, createdAt], map: "LiveEntryAcceptanceRun_tradingAccountSubscriptionId_created_idx")
  @@index([terminalOutcome, terminalAt])
  @@index([executionUncertainAt])
}

model LiveEntryArmingTermination {
  id                    Int @id @default(autoincrement())
  liveEntryArmingId     Int
  liveEntryArming       LiveEntryArming @relation(fields: [liveEntryArmingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type                  LiveEntryArmingTerminationType
  actorUserId           Int?
  actorUser             User? @relation("LiveEntryArmingTerminationActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reason                String
  orderIntentId         Int?
  clientOrderId         String?
  evidenceJson          Json
  occurredAt            DateTime @default(now())

  @@index([liveEntryArmingId, occurredAt])
  @@index([type, occurredAt])
  @@index([orderIntentId])
  @@unique([liveEntryArmingId, type])
}

model TradingAccountLiveWriteApprovalDecision {
  id                       Int @id @default(autoincrement())
  tradingAccountId         Int
  tradingAccount           TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  capability               LiveWriteCapability
  action                   LiveWriteApprovalAction
  actorUserId              Int?
  actorUser                User? @relation("LiveWriteApprovalDecisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reason                   String
  configurationFingerprint String
  credentialFingerprint    String
  readinessAssessmentId    Int?
  readinessAssessment      TradingAccountReadinessAssessment? @relation(fields: [readinessAssessmentId], references: [id], onDelete: SetNull)
  deploymentEnvironment    String
  priorRevision            Int
  resultingRevision        Int
  expiresAt                DateTime?
  createdAt                DateTime @default(now())

  @@index([tradingAccountId, capability, createdAt])
  @@index([actorUserId])
}

model TradingAccountRiskSettings {
  id                                  Int @id @default(autoincrement())

  tradingAccountId                    Int @unique
  tradingAccount                      TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  enabled                             Boolean @default(true)

  maxDailyEntryOrders                 Int?
  maxDailyEntryNotional               Float?
  maxOpenPositions                    Int?
  maxTotalOpenNotional                Float?
  maxSymbolOpenNotional               Float?
  maxSubscriptionOpenNotional         Float?

  notes                               String?

  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  @@index([enabled])
}

enum BrokerCredentialAuthType {
  API_KEY
  OAUTH
}

enum BrokerCredentialStatus {
  NEEDS_VERIFICATION
  ACTIVE
  INVALID
  REVOKED
}

model TradingAccountCredential {
  id                      Int @id @default(autoincrement())

  tradingAccountId        Int @unique
  tradingAccount          TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  authType                BrokerCredentialAuthType @default(API_KEY)
  status                  BrokerCredentialStatus @default(NEEDS_VERIFICATION)

  apiKeyCiphertext        String?
  apiSecretCiphertext     String?

  accessTokenCiphertext   String?
  refreshTokenCiphertext  String?

  keyFingerprint          String?
  encryptionVersion       Int @default(1)

  verifiedAt              DateTime?
  lastUsedAt              DateTime?
  lastFailedAt            DateTime?
  revokedAt               DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status])
}

// Membership grants access to an account's scope.
// Capabilities come from the user's platform role and platform permissions.
model TradingAccountMembership {
  id                    Int @id @default(autoincrement())

  tradingAccountId      Int
  tradingAccount        TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  userId Int
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tradingAccountId, userId])
  @@index([userId])
}

model TradingAccountAllocation {
  id                      Int @id @default(autoincrement())

  tradingAccountId        Int
  tradingAccount          TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  key                     String
  name                    String
  description             String?

  enabled                 Boolean @default(true)

  // Maximum capital this enabled allocation may control within the account ceiling.
  // Nullable while legacy allocation configuration is identified and corrected.
  maxAllocatedNotional    Float?

  // Useful for shared buckets like momentum.
  maxOpenPositions        Int?

  // Authoritative per-position ceiling for subscriptions assigned to this allocation.
  maxPositionNotional     Float?

  notes String?

  accountSubscriptions    TradingAccountSubscription[] @relation("TradingAccountAllocationSubscriptions")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([tradingAccountId, key])
  @@unique([id, tradingAccountId], map: "TradingAccountAllocation_id_tradingAccountId_key")
  @@index([tradingAccountId])
  @@index([enabled])
}

model TradingAccountSubscription {
  id Int @id @default(autoincrement())

  tradingAccountId      Int
  tradingAccount        TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  subscriptionId        Int
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  allocationId          Int?
  allocation            TradingAccountAllocation? @relation("TradingAccountAllocationSubscriptions", fields: [allocationId, tradingAccountId], references: [id, tradingAccountId], onDelete: Restrict, onUpdate: Restrict)

  // Master account-subscription switch.
  enabled               Boolean @default(true)

  // Operational switches.
  entriesEnabled        Boolean @default(true)
  exitsEnabled          Boolean @default(true)

  sizingType            PositionSizingType @default(FIXED_QTY)

  // Used when sizingType = FIXED_QTY.
  fixedQty              Float?

  // Used when sizingType = MAX_NOTIONAL.
  maxPositionNotional   Float?

  // Capital reserved inside the assigned allocation, independent of sizing type.
  // Nullable while legacy account subscriptions are identified and corrected.
  reservedNotional      Float?

  // Optional guardrails.
  minPositionNotional   Float?
  maxQty                Float?

  notes String?

  orderIntents          OrderIntent[]
  trackedPositions      TrackedPosition[]
  entryDecisions        EntryDecision[]
  lifecycleExerciseTargets TradingLifecycleExerciseTarget[]
  liveEntryArmings       LiveEntryArming[]
  liveEntryAcceptanceRuns LiveEntryAcceptanceRun[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tradingAccountId, subscriptionId])
  @@index([tradingAccountId])
  @@index([subscriptionId])
  @@index([allocationId])
  @@index([enabled])
